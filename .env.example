# Variabile de mediu necesare

Copiază acest fișier ca `.env` pentru testare locală cu SMTP real
(`node --env-file=.env src/server.js`), sau introdu-le direct în Railway,
sub Variables. Nu comite niciodată `.env` cu valori reale — e deja în
.gitignore.

# --- Baza de date (Postgres) ---
# Pe Railway: New -> Database -> PostgreSQL, apoi copiezi DATABASE_URL
# din tabul Variables al serviciului Postgres. Fara ea, cache-ul PVGIS
# si lead-urile cad automat pe fisiere / consola - functioneaza, dar
# nu persista intre redeploy-uri.
DATABASE_URL=

# --- SMTP (livrarea lead-urilor pe email) ---
# Fara acestea, formularul de oferta functioneaza dar niciun email nu
# pleaca - vezi nota "SMTP neconfigurat" din server.js. Merge cu orice
# furnizor SMTP obisnuit (Gmail cu parola de aplicatie, Zoho, un cont
# de hosting). Testeaza-le local cu scripts/test-smtp.js ÎNAINTE de a
# le pune pe Railway.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Motor ---
PORT=3000
NODE_ENV=production

# Modul demonstrativ (date PVGIS sintetice, fara apel real) - NU se
# seteaza pe Railway. E doar pentru dezvoltare locala, prin flag:
#   node src/server.js --mock
